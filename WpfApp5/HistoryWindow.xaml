<Window x:Class="WpfApp5.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История заметок" Height="400" Width="300"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Архив заметок" FontSize="18" FontWeight="Bold" Margin="10"/>
        
        <ListBox x:Name="HistoryList" Grid.Row="1" Margin="10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" Margin="2" Padding="5" Background="#FFF7D1">
                        <StackPanel>
                            <TextBlock Text="{Binding PreviewText}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding DateFormatted}" FontSize="10" Foreground="Gray"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Button Content="Восстановить" Click="Restore_Click" Tag="{Binding FilePath}" Margin="0,0,5,0" Padding="2"/>
                                <Button Content="Удалить" Click="Delete_Click" Tag="{Binding FilePath}" Padding="2"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
